# Build-context filter for images built from the repo root
# (deploy/web.Dockerfile AND apps/backend/Dockerfile — the backend build
# context moved to the root so providers.toml can be copied in).
# Keeps the context small and keeps host installs/secrets out of images (R4).
.git
.venv
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/.pytest_cache
**/*.egg-info
apps/backend/tests/
data/
.env
.env.*
!.env.demo
