# ═══════════════════════════════════════════════════════════════════════════
# BebshaX DEMO-DAY environment (offline exhibition, no internet at the venue)
#
# On demo day: BACKUP YOUR .env FIRST, then copy this file over it:
#   PowerShell>  Copy-Item .env .env.backup; Copy-Item .env.demo .env
# Then verify:  .\.venv\Scripts\python scripts\demo_preflight.py
#
# Everything here is LOCAL — no cloud database, no API keys required
# (keyless providers + Ollama are a supported configuration). NO real
# secrets belong in this file; it is committed to git.
# ═══════════════════════════════════════════════════════════════════════════

# Local pgvector container from docker-compose.yml (service `db`, port 5433 —
# native PG16 owns 5432 and lacks pgvector). Credentials are the compose-local
# dev defaults, not secrets.
BEBSHAX_DATABASE_URL=postgresql+asyncpg://bebshax:bebshax@localhost:5433/bebshax

# Demo mode: seeds the demo user/business/personas on first startup and
# labels seeded content CACHED in the UI (docs/DEMO.md §2-§4).
BEBSHAX_DEMO_MODE=true

# REQUIRED, minimum 32 chars — the backend refuses to start with this
# placeholder (by design). Generate a real one and paste it here:
#   .\.venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
BEBSHAX_JWT_SECRET=CHANGE-ME

# Deterministic offline embeddings (default). Set to `auto` only if Ollama
# has nomic-embed-text pulled AND the daemon will stay up for the whole demo.
BEBSHAX_EMBEDDING_BACKEND=local

# Local/dev environment: email verification is NOT enforced, so the seeded
# founder@bebshax.ai / Password123! demo login works without email delivery.
BEBSHAX_ENVIRONMENT=development

# Frontend (Vite reads this repo-root .env — apps/frontend/vite.config.ts
# sets envDir '../..'): an explicitly EMPTY value disables the "Continue
# with Google" button. Federated sign-in needs the internet; leaving the
# default cloud endpoint active would make the button fail live at the
# offline venue. Sign in with the seeded founder@bebshax.ai instead.
VITE_NEON_AUTH_URL=

# ── Deliberately absent (offline demo needs none of these) ──────────────────
# BEBSHAX_RESEND_API_KEY=        (email delivery — cloud)
# BEBSHAX_STRIPE_SECRET_KEY=     (payments — cloud)
# BEBSHAX_STRIPE_PUBLISHABLE_KEY=
# BEBSHAX_STRIPE_WEBHOOK_SECRET=
# Provider API keys (OpenRouter etc.) are optional everywhere; the routing
# ladder falls back to keyless providers and then to local Ollama.
