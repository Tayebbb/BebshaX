# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Node / frontend
node_modules/
apps/frontend/dist/

# Environment & secrets — never commit real keys
.env
.env.*
!.env.example
!.env.demo

# Datasets: raw/processed are reproducible via scripts; metadata is tracked
data/raw/*
data/processed/*
data/uploads/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/uploads/.gitkeep

# The rules above are root-anchored, but UPLOAD_DIR is Path("data/uploads") —
# relative to the process working directory. Running the server or the suite
# from apps/backend therefore writes apps/backend/data/uploads/, which the
# root-anchored rules do not match: 13 test artifacts reached git this way in
# e8873d4. These patterns catch the directory at any depth.
**/data/raw/*
**/data/processed/*
**/data/uploads/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep
!**/data/uploads/.gitkeep

# OS / editor
.DS_Store
Thumbs.db

# coverage artifacts (M11 gate)
.coverage*
htmlcov/
coverage.xml
.neon

# AI Agent Skills (restorable via skills-lock.json)
.agents/skills/

# Chromium crashpad logs dropped by the embedded browser tooling next to whatever file was open
debug.log

# Generated operations verification, dependency wheels, recovery bundles and staged releases
.tmp/
deploy/wheelhouse/
deploy/artifacts/
deploy/recovery/
deploy/*.generated.json
deploy/*.generated.conf

# Agent/test receipts written next to the code they verified (never source)
.pytest_*.out
.pytest_*.err
.pytest_tmp_*/
.playwright-mcp/
.test-artifacts/
testsbuilt.tmp/
.cache/
apps/frontend/tests/.modernization-*
apps/frontend/tests/*.results.json
apps/frontend/.tsupgrader/
apps/frontend/.vitest/
apps/frontend/test-results/
# dot-prefixed run receipts (json/xml/stdout/sqlite) dropped inside the backend test tree
apps/backend/tests/**/.[!.]*
!apps/backend/tests/**/.gitkeep
apps/backend/tests/**/*.stdout
apps/backend/tests/**/*.stderr
.tsupgrader/
