# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Node / frontend
node_modules/
apps/frontend/dist/

# Environment & secrets — never commit real keys
.env
.env.*
!.env.example
!.env.demo

# Datasets: raw/processed are reproducible via scripts; metadata is tracked
data/raw/*
data/processed/*
data/uploads/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/uploads/.gitkeep

# The rules above are root-anchored, but UPLOAD_DIR is Path("data/uploads") —
# relative to the process working directory. Running the server or the suite
# from apps/backend therefore writes apps/backend/data/uploads/, which the
# root-anchored rules do not match: 13 test artifacts reached git this way in
# e8873d4. These patterns catch the directory at any depth.
**/data/raw/*
**/data/processed/*
**/data/uploads/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep
!**/data/uploads/.gitkeep

# OS / editor
.DS_Store
Thumbs.db

# coverage artifacts (M11 gate)
.coverage*
htmlcov/
coverage.xml
