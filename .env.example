# BebshaX configuration template — copy to .env and fill in. Never commit .env.

# --- Core ---
BEBSHAX_ENVIRONMENT=development
BEBSHAX_API_HOST=127.0.0.1
BEBSHAX_API_PORT=8000
BEBSHAX_DEMO_MODE=false

# --- Database (consumed from Phase 6; matches docker-compose.yml pgvector service on 5433) ---
BEBSHAX_DATABASE_URL=postgresql+asyncpg://bebshax:bebshax@localhost:5433/bebshax

# --- JWT (B4 — REQUIRED, no default) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BEBSHAX_JWT_SECRET=<generate-and-paste-here>
# BEBSHAX_JWT_SECRET_PREVIOUS=   # set only during key rotation

# --- Memory embeddings (Phase 9) ---
# "local" = deterministic hash embedding (offline, free, consistent — default).
# "freellmpool" = remote embeddings with failover; REQUIRES a pinned model so all
# vectors share one space (see docs/PERSONA_ENGINE.md § Memory).
BEBSHAX_EMBEDDING_BACKEND=local
# BEBSHAX_EMBEDDING_MODEL=

# --- LLM provider keys (ALL OPTIONAL — read by freellmpool from Phase 3) ---
# Add only keys from legitimately-owned free-tier accounts. Keyless providers
# (Pollinations, OVHcloud, Kilo, LLM7) need no key at all.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# COHERE_API_KEY=
# GITHUB_TOKEN=
# HF_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# --- Ollama (local reliability fallback, Phase 4) ---
# OLLAMA_API_BASE=http://localhost:11434
