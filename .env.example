# BebshaX configuration template — copy to .env and fill in. Never commit .env.
# Every `Settings` field in apps/backend/bebshax/config.py appears here (test:
# apps/backend/tests/test_ops_env_parity.py). Non-BEBSHAX_ names are read
# straight from the environment by the adapters/freellmpool.

# --- Core ---
# Display name used in API metadata/emails
# BEBSHAX_APP_NAME=BebshaX
BEBSHAX_ENVIRONMENT=development
BEBSHAX_API_HOST=127.0.0.1
BEBSHAX_API_PORT=8000
BEBSHAX_DEMO_MODE=false
# Root logger level when nothing else configures logging (DEBUG/INFO/WARNING/ERROR)
# BEBSHAX_LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS (no wildcard — credentials are enabled)
# Vite dev serves with host:true — add your LAN IP origin (e.g. http://192.168.1.20:5173) if testing from another device
# BEBSHAX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Regex for additional allowed origins; default matches ONLY localhost/127.0.0.1
# on any port. Deployed frontends belong in BEBSHAX_CORS_ORIGINS, not here — a
# loose regex + credentials lets any matching origin act as a logged-in user.
# BEBSHAX_CORS_ORIGIN_REGEX=http://localhost:\d+|http://127\.0\.0\.1:\d+

# --- Data directories (uploads + processed datasets) ---
# Relative paths resolve against the process CWD (dev default: repo-root data/).
# Containers set an absolute, volume-backed path (the backend image bakes in /app/data).
# BEBSHAX_DATA_DIR=data
# Explicit overrides (default: <BEBSHAX_DATA_DIR>/uploads and /processed)
# BEBSHAX_UPLOAD_DIR=
# BEBSHAX_PROCESSED_DIR=
BEBSHAX_ML_PERSONA_ARTIFACT_DIR=
# Where /api/evaluation/metrics looks for judged quality-gate reports
# (local_3b_gate_*.json). Read via os.environ, CWD-relative by default; compose
# bind-mounts ./data/metadata read-only at /app/data/metadata.
# BEBSHAX_METADATA_DIR=data/metadata

# --- Database (consumed from Phase 6; matches docker-compose.yml pgvector service on 5433) ---
BEBSHAX_DATABASE_URL=postgresql+asyncpg://bebshax:bebshax@localhost:5433/bebshax
# Connection pool sizing (per process)
# BEBSHAX_DB_POOL_SIZE=5
# BEBSHAX_DB_MAX_OVERFLOW=5

# --- JWT (B4 — REQUIRED, no default) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BEBSHAX_JWT_SECRET=<generate-and-paste-here>
# BEBSHAX_JWT_SECRET_PREVIOUS=   # set only during key rotation
# Session length in days (default 1). Tokens are bearer credentials held in
# localStorage, so this is the window a stolen one stays usable — there is no
# revocation list. Was 365 by accident (audit).
# BEBSHAX_JWT_EXPIRE_DAYS=1
# Token claims/algorithm — change only if a second service must validate
# BebshaX tokens; existing sessions become invalid when these change.
# BEBSHAX_JWT_ISSUER=bebshax-api
# BEBSHAX_JWT_AUDIENCE=bebshax-client
# BEBSHAX_JWT_ALGORITHM=HS256

# --- Federated sign-in (Neon Auth) ---
# Base URL of YOUR Neon Auth tenant. Empty (default) disables federated
# sign-in — /api/auth/sync answers 503 — while email/password auth still works.
# BEBSHAX_NEON_AUTH_URL=https://<your-tenant>.neonauth.<region>.aws.neon.tech/neondb/auth
# NOT READ BY ANYTHING (legacy names from an earlier Neon setup — drop them
# from your .env): NEON_AUTH_BASE_URL, VITE_NEON_AUTH_JWKS_URL. The backend
# reads BEBSHAX_NEON_AUTH_URL; the frontend reads VITE_NEON_AUTH_URL (below).

# --- Rate limiting ---
# slowapi storage backend; unset = in-memory per process (fine for one worker).
# Use a shared store when running multiple workers/replicas.
# BEBSHAX_RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
# Set true ONLY behind a trusted proxy that overwrites X-Forwarded-For
# (the shipped nginx does) — otherwise clients can spoof their identity.
# BEBSHAX_RATE_LIMIT_TRUST_FORWARDED_FOR=false

# --- Email verification (H9) ---
# Unset = enforced in production/staging, off in development/local so the
# offline demo drill still passes. Set to true/false to override explicitly.
# Turning it ON needs the frontend "check your email" state, or a blocked
# signin surfaces as a bare 403.
# BEBSHAX_REQUIRE_EMAIL_VERIFICATION=true

# --- Memory embeddings (Phase 9) ---
# "local" = deterministic hash embedding (offline, free, consistent — default).
# "freellmpool" = remote embeddings with failover; REQUIRES a pinned model so all
# vectors share one space (see docs/PERSONA_ENGINE.md § Memory).
BEBSHAX_EMBEDDING_BACKEND=local
# BEBSHAX_EMBEDDING_MODEL=

# --- LLM provider keys (ALL OPTIONAL — read by freellmpool from Phase 3) ---
# Add only keys from legitimately-owned free-tier accounts. Keyless providers
# (Pollinations, OVHcloud, Kilo, LLM7) need no key at all.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# COHERE_API_KEY=
# GITHUB_TOKEN=
# HF_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Path to the freellmpool provider catalog (providers.toml). Auto-detected at
# the repo root in dev; the backend image bakes in /app/providers.toml.
# FREELLMPOOL_CONFIG=providers.toml
# Override the OpenRouter free-tier model list (comma-separated) — catalogs drift.
# BEBSHAX_OPENROUTER_MODELS=google/gemini-2.0-flash-exp:free,openrouter/auto
# Default OpenRouter model for the health check + OpenRouterService when no
# role-specific override is set (read via os.environ; default in
# llm/openrouter_service.py). Role overrides: MODEL_PERSONA, MODEL_REASONING,
# MODEL_EXTRACTION, MODEL_CRITIC, MODEL_BROWSER.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# --- Ollama (local reliability fallback, Phase 4) ---
# OLLAMA_API_BASE=http://localhost:11434

# --- Email verification (H9 — Resend integration) ---
# Required in production/staging environments (free tier: 3,000/mo, 100/day at resend.com)
# BEBSHAX_RESEND_API_KEY=re_123456789
# Sender address — REQUIRED in production/staging; must be on a domain verified
# with your email provider (Resend refuses unverified domains).
# BEBSHAX_EMAIL_FROM_ADDRESS=noreply@example.com
# BEBSHAX_FRONTEND_BASE_URL=http://localhost:5173
# SMTP delivery (tried before Resend when username+password are set)
# BEBSHAX_SMTP_HOST=smtp-relay.brevo.com
# BEBSHAX_SMTP_PORT=587
# BEBSHAX_SMTP_USERNAME=
# BEBSHAX_SMTP_PASSWORD=

# --- Stripe (Payment Integration) ---
# BEBSHAX_STRIPE_SECRET_KEY=sk_test_...
# BEBSHAX_STRIPE_PUBLISHABLE_KEY=pk_test_...
# BEBSHAX_STRIPE_WEBHOOK_SECRET=whsec_...
# Optional Stripe Dashboard price ids; when set, checkout uses them instead of
# the inline (hardcoded) price_data amounts.
# BEBSHAX_STRIPE_PRICE_ID_PRO=price_...
# BEBSHAX_STRIPE_PRICE_ID_ENTERPRISE=price_...

# --- Frontend build-time vars (Vite inlines VITE_* at build; apps/frontend) ---
# Vite reads the REPO-ROOT .env (apps/frontend/vite.config.ts envDir '../..').
# Because these are baked in at `npm run build` / web-image build time, set
# them BEFORE building — changing .env afterwards does not change a dist.
# API origin/prefix the SPA calls; the docker web image defaults to /api (same-origin proxy).
# VITE_API_BASE=http://127.0.0.1:8000/api
# 1 = fully mocked frontend (no backend needed) — dev/demo only.
# VITE_MOCK=0
# Neon Auth tenant URL for federated sign-in; empty/unset disables the button.
# VITE_NEON_AUTH_URL=
