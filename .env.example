# BebshaX configuration template — copy to .env and fill in. Never commit .env.

# --- Core ---
BEBSHAX_ENVIRONMENT=development
BEBSHAX_API_HOST=127.0.0.1
BEBSHAX_API_PORT=8000
BEBSHAX_DEMO_MODE=false
# Comma-separated browser origins allowed by CORS (no wildcard — credentials are enabled)
# Vite dev serves with host:true — add your LAN IP origin (e.g. http://192.168.1.20:5173) if testing from another device
# BEBSHAX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Database (consumed from Phase 6; matches docker-compose.yml pgvector service on 5433) ---
BEBSHAX_DATABASE_URL=postgresql+asyncpg://bebshax:bebshax@localhost:5433/bebshax

# --- JWT (B4 — REQUIRED, no default) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BEBSHAX_JWT_SECRET=<generate-and-paste-here>
# BEBSHAX_JWT_SECRET_PREVIOUS=   # set only during key rotation
# Session length in days. Tokens are bearer credentials held in localStorage,
# so this is the window a stolen one stays usable. Was 365 by accident (audit).
# BEBSHAX_JWT_EXPIRE_DAYS=7

# --- Email verification (H9) ---
# Unset = enforced in production/staging, off in development/local so the
# offline demo drill still passes. Set to true/false to override explicitly.
# Turning it ON needs the frontend "check your email" state, or a blocked
# signin surfaces as a bare 403.
# BEBSHAX_REQUIRE_EMAIL_VERIFICATION=true

# --- Memory embeddings (Phase 9) ---
# "local" = deterministic hash embedding (offline, free, consistent — default).
# "freellmpool" = remote embeddings with failover; REQUIRES a pinned model so all
# vectors share one space (see docs/PERSONA_ENGINE.md § Memory).
BEBSHAX_EMBEDDING_BACKEND=local
# BEBSHAX_EMBEDDING_MODEL=

# --- LLM provider keys (ALL OPTIONAL — read by freellmpool from Phase 3) ---
# Add only keys from legitimately-owned free-tier accounts. Keyless providers
# (Pollinations, OVHcloud, Kilo, LLM7) need no key at all.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=
# COHERE_API_KEY=
# GITHUB_TOKEN=
# HF_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# --- Ollama (local reliability fallback, Phase 4) ---
# OLLAMA_API_BASE=http://localhost:11434

# --- Email verification (H9 — Resend integration) ---
# Required in production/staging environments (free tier: 3,000/mo, 100/day at resend.com)
# BEBSHAX_RESEND_API_KEY=re_123456789
# BEBSHAX_EMAIL_FROM_ADDRESS=noreply@bebshax.ai
# BEBSHAX_FRONTEND_BASE_URL=http://localhost:5173

